# ── Application ──────────────────────────────────────────────
# Subpath routing prefix. Leave blank for root domain ("/")
# Set e.g. "myapp" or "/myapp" when behind a reverse proxy
ROUTE_PATH=

# Override default config file path (default: config/settings.json)
# CONFIG_PATH=config/settings.json

# ── Server ───────────────────────────────────────────────────
PORT=4016
HOST=0.0.0.0

# ── Environment ──────────────────────────────────────────────
APP_ENV=development
